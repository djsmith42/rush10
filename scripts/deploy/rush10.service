[Unit]
Description=Rush 10 API server
After=network.target

[Service]
Type=simple
# A dedicated account with no login and no sudo: a compromised server can't become dave or root.
User=rush10
Group=rush10
WorkingDirectory=/home/dave/rush10/artifacts/api-server
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3010
Environment=DATABASE_PATH=/var/lib/rush10/rush10.db
ExecStart=/opt/node24/bin/node --enable-source-maps dist/index.mjs
Restart=always
RestartSec=5
# Keep a flood from starving the rest of the box.
MemoryMax=512M
CPUQuota=150%
TasksMax=64
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

# Sandbox: the only writable path is the database directory, and the only visible
# part of /home is this repo, read-only. Database files stay readable by group rush10
# (dave is a member) so ./dbdump works.
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rush10
ProtectHome=tmpfs
BindReadOnlyPaths=/home/dave/rush10
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# Not MemoryDenyWriteExecute: V8's JIT needs writable+executable memory.

[Install]
WantedBy=multi-user.target
